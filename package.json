{
  "name": "auditbooks-dev",
  "version": "0.37.8",
  "description": "Simple book-keeping app for everyone",
  "author": {
    "name": "Landigit Agency",
    "email": "landigitagency@gmail.com"
  },
  "scripts": {
    "dev": "node build/scripts/dev.mjs",
    "build": "node build/scripts/build.mjs",
    "postinstall": "pnpm electron-rebuild",
    "electron-rebuild": "node build/scripts/rebuild.mjs",
    "type": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "check": "pnpm lint && pnpm type",
    "full-check": "pnpm check && pnpm test",
    "uitest": "node uitest/index.mjs",
    "script:translate": "scripts/runner.sh scripts/generateTranslations.ts",
    "script:profile": "scripts/profile.sh",
    "release:win": "powershell -ExecutionPolicy Bypass -File scripts/publish-windows.ps1",
    "release:mac-arm": "scripts/publish-mac-arm.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.4.2",
    "@codemirror/lang-vue": "^0.1.1",
    "@floating-ui/dom": "^1.7.6",
    "@internationalized/date": "^3.12.1",
    "@lezer/highlight": "^1.2.3",
    "@libsql/client": "^0.17.3",
    "@lucide/vue": "^1.16.0",
    "bree": "^9.2.9",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.10",
    "drizzle-orm": "^0.45.2",
    "electron-store": "^8.2.0",
    "marked": "^18.0.3",
    "pesa": "^1.1.13",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.7",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.5.33",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^9.39.4",
    "@lezer/common": "^1.5.2",
    "@tailwindcss/vite": "^4.2.4",
    "@types/assert": "^1.5.11",
    "@types/node": "^20.19.39",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@typescript-eslint/utils": "^8.59.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-dom": "^3.5.33",
    "@vue/test-utils": "^2.4.10",
    "chokidar": "^4.0.3",
    "dmg-builder": "^25.0.8",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^34.5.8",
    "electron-builder": "^25.0.8",
    "electron-builder-squirrel-windows": "^25.0.8",
    "electron-updater": "^6.8.4",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^9.33.0",
    "execa": "^7.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "tslib": "^2.8.1",
    "tsx": "4.22.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.4.2",
    "vitest": "^4.1.6",
    "vue-tsc": "^2.2.12",
    "yargs": "^17.7.2"
  },
  "pnpm": {
    "blockExoticSubdeps": false,
    "overrides": {
      "node-abi": "^3.90.0",
      "tar": ">=7.5.11",
      "@tootallnate/once": ">=3.0.1",
      "vite": "^6.4.2"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "endOfLine": "auto"
  },
  "homepage": "https://landigit.com",
  "repository": {
    "url": "https://github.com/landigit/auditbooks"
  },
  "license": "AGPL-3.0-only"
