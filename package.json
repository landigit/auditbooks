    "type": "vue-tsc --noEmit",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix && vp fmt .",
    "format": "vp fmt .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "bun run lint && bun run type",
    "full-check": "bun run check && bun run test",
    "prepare": "vp config"
  },
