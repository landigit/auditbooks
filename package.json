{
  "name": "auditbooks",
  "version": "0.37.12",
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "description": "Simple book-keeping app for everyone",
  "author": {
    "name": "Landigit Agency",
    "email": "landigitagency@gmail.com"
  },
  "scripts": {
    "codegen": "tsx scripts/codegen.ts",
    "dev": "tauri dev",
    "compile:translations": "tsx scripts/compileTranslations.ts",
    "dev:frontend": "pnpm compile:translations && vite",
    "build": "tauri build",
    "build:frontend": "pnpm compile:translations && vite build",
    "tauri": "tauri",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "script:translate": "scripts/runner.sh scripts/generateTranslations.ts",
    "script:profile": "scripts/profile.sh",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "vue-tsc --noEmit",
    "uitest": "node uitest/index.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "pdfkit": "^0.19.1",
    "pdfmake": "^0.3.11",
    "pesa": "^1.1.13",
    "pinia": "^2.3.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@libsql/client": "^0.8.1",
    "@libsql/kysely-libsql": "^0.4.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.11.3",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.24",
    "@types/luxon": "^3.7.2",
    "@types/node": "^22.20.0",
    "@types/pdfmake": "^0.3.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-dom": "^3.5.38",
    "@vue/test-utils": "^2.4.11",
    "chrome-remote-interface": "^0.34.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "fs-extra": "^11.3.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "kysely": "^0.29.2",
    "kysely-codegen": "^0.20.0",
    "lightningcss": "^1.32.0",
    "prettier": "^3.8.4",
    "shadcn-vue": "^2.7.4",
    "tailwindcss": "^4.3.1",
    "tap-spec": "^5.0.0",
    "tape": "^5.10.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "vue-tsc": "^3.3.5"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "endOfLine": "auto"
  },
  "homepage": "https://landigit.com/auditbooks",
  "repository": {
    "url": "https://github.com/landigit/auditbooks"
