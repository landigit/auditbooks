{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "frappe-books",
  "version": "0.1.0",
  "identifier": "com.frappebooks.app",
  "build": {
    "frontendDist": "../src/dist",
    "devUrl": "http://localhost:6969",
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Frappe Books",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
