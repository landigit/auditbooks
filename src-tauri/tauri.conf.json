{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Auditbooks",
  "version": "0.37.9",
  "identifier": "com.landigit.auditbooks",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:6969",
    "beforeDevCommand": "bun run scripts/build-sidecar.ts && bun run dev:web",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Auditbooks",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../books", "../translations"],
    "icon": [
      "icons/desktop/32x32.png",
      "icons/desktop/128x128.png",
      "icons/desktop/128x128@2x.png",
      "icons/desktop/icon.icns",
      "icons/desktop/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/desktop/installerIcon.ico",
        "uninstallerIcon": "icons/desktop/uninstallerIcon.ico"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
