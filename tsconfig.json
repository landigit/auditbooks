{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "jsx": "preserve",
    "importHelpers": true,
    "useDefineForClassFields": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client", "bun-types"],
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"],
      "fyo": ["src/fyo"],
      "fyo/*": ["src/fyo/*"],
      "schemas": ["src/schemas"],
      "schemas/*": ["src/schemas/*"],
      "backend/*": ["backend/*"],
      "regional/*": ["regional/*"],
      "fixtures/*": ["fixtures/*"],
      "reports": ["src/reports"],
      "reports/*": ["src/reports/*"],
      "models": ["src/models"],
      "models/*": ["src/models/*"],
      "utils": ["src/utils/core"],
      "utils/*": ["src/utils/core/*"],
      "dummy/*": ["dummy/*"]
    },
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "ts-node": {
    "files": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "schemas/**/*.ts",
    "backend/**/*.ts",
    "fyo/**/*.ts",
    "models/**/*.ts",
    "patches/**/*.ts",
    "patches/**/*.js",
    "reports/**/*.ts",
    "accounting/**/*.ts",
    "regional/**/*.ts",
    "utils/**/*.ts",
    "tests/**/*.ts",
    "dummy/**/*.ts",
    "jobs/**/*.ts",
    "*.config.ts",
    "*.config.mjs",
    "*.config.js"
  ],
  "exclude": ["node_modules", "src-tauri/**"]
}
